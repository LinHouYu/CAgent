<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CAgent.Desktop.ViewModels"
        x:Class="CAgent.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CAgent — Microsoft Copilot 电脑操控代理"
        Width="1040"
        Height="740"
        MinWidth="780"
        MinHeight="540"
        FontFamily="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="16">

        <!-- 1. Streamlined Single-Row Top Header: Edition + Account | Connection Status + One-Click New Chat + Settings -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentPrimaryBrush}"
                            CornerRadius="8"
                            Padding="10,5"
                            VerticalAlignment="Center">
                        <TextBlock Text="CAgent"
                                   Foreground="#FFFFFF"
                                   FontWeight="Bold"
                                   FontSize="15" />
                    </Border>

                    <Border Background="{DynamicResource ElevatedBgBrush}"
                            CornerRadius="9"
                            Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton x:Name="PersonalEditionButton"
                                          Classes="segment"
                                          Padding="11,5"
                                          Content="个人版"
                                          IsChecked="{Binding IsPersonalEditionActive, Mode=OneWay}"
                                          Command="{Binding SwitchToPersonalCommand}" />
                            <ToggleButton x:Name="WorkEditionButton"
                                          Classes="segment"
                                          Padding="11,5"
                                          Content="工作版 M365"
                                          IsChecked="{Binding IsWorkEditionActive, Mode=OneWay}"
                                          Command="{Binding SwitchToWorkCommand}" />
                        </StackPanel>
                    </Border>

                    <ComboBox x:Name="AccountSelectorCombo"
                              ItemsSource="{Binding Accounts}"
                              SelectedItem="{Binding SelectedAccount}"
                              MinWidth="170"
                              MaxWidth="240"
                              CornerRadius="8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountItemViewModel">
                                <TextBlock Text="{Binding FullLabel}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button x:Name="OpenAddAccountButton"
                            Classes="pill"
                            Padding="10,6"
                            Content="+ 账号"
                            ToolTip.Tip="添加新的独立浏览器会话账号"
                            Command="{Binding ToggleAddAccountPanelCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{DynamicResource ElevatedBgBrush}"
                            CornerRadius="999"
                            MaxWidth="195"
                            Padding="12,6"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatusText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentHighlightBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Button x:Name="NewChatButton"
                            Classes="primary"
                            Content="✨ 新建对话"
                            ToolTip.Tip="一键启动/连接浏览器、在网页开启新对话并自动发送系统提示词与扫描工作目录"
                            Command="{Binding StartNewChatCommand}" />

                    <Button x:Name="SettingsToggleButton"
                            Classes="pill"
                            Content="⚙️ 设置"
                            Command="{Binding ToggleSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1b. Inline Add-Account Drawer -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsAddAccountPanelOpen}"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource AccentHighlightBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="新增独立浏览器会话账号：" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox x:Name="NewAccountNameTextBox"
                         Width="220"
                         Watermark="账号备注名（如：公司研发号）"
                         Text="{Binding NewAccountName}" />
                <CheckBox x:Name="NewAccountIsWorkCheckBox"
                          Content="设为工作版 (M365 企业号)"
                          IsChecked="{Binding NewAccountIsWork}" />
                <Button x:Name="ConfirmAddAccountButton"
                        Classes="primary"
                        Content="确认创建"
                        Command="{Binding ConfirmAddAccountCommand}" />
                <Button Classes="pill"
                        Content="取消"
                        Command="{Binding CancelAddAccountCommand}" />
            </StackPanel>
        </Border>

        <!-- 2. Workspace Bar & Collapsible Settings Panel -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
            <Border Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0"
                               Text="📁 本地工作目录："
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox x:Name="WorkspacePathTextBox"
                             Grid.Column="1"
                             Text="{Binding WorkspacePath}"
                             Watermark="选择或粘贴允许 Copilot 操控的本地文件夹路径（所有生成代码将严格存放在此目录）..."
                             CornerRadius="7" />
                    <Button x:Name="BrowseWorkspaceButton"
                            Grid.Column="2"
                            Classes="pill"
                            Content="浏览文件夹..."
                            Margin="8,0,0,0"
                            Click="OnBrowseWorkspaceClicked" />
                </Grid>
            </Border>

            <!-- Collapsible Low-Frequency Utilities, Safety Guardrails & Persistence Settings -->
            <Border x:Name="SettingsDrawerBorder"
                    IsVisible="{Binding IsSettingsExpanded}"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <StackPanel Spacing="10">
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="ThemeToggleButton"
                                Classes="pill"
                                Margin="0,0,8,6"
                                Content="{Binding ThemeButtonText}"
                                Command="{Binding ToggleThemeCommand}" />
                        <Button x:Name="ConnectBrowserButton"
                                Classes="pill"
                                Margin="0,0,8,6"
                                Content="🌐 仅启动/连接浏览器"
                                Command="{Binding ConnectBrowserCommand}" />
                        <Button x:Name="CalibrateButton"
                                Classes="pill"
                                Margin="0,0,8,6"
                                Content="🎯 校准输入框"
                                ToolTip.Tip="若网页改版导致找不到输入框，点击此按钮并在浏览器输入框单击一次即可自愈"
                                Command="{Binding CalibrateInputCommand}" />
                        <Button Classes="pill"
                                Margin="0,0,8,6"
                                Content="🧹 清空当前记录"
                                Command="{Binding ClearTimelineCommand}" />
                        <Button x:Name="RemoveAccountButton"
                                Classes="pill"
                                Margin="0,0,8,6"
                                Content="🗑️ 删除当前账号"
                                IsVisible="{Binding CanRemoveCurrentAccount}"
                                Command="{Binding RemoveCurrentAccountCommand}" />
                    </WrapPanel>

                    <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" />

                    <TextBlock Text="安全护栏与防风控参数（所有修改自动保存至 config.json，下次启动自动还原）"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentHighlightBrush}" />

                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="AutoApproveCheckBox"
                                  Content="执行模式下自动连续调用工具（关闭则每次命令均需人工确认）"
                                  IsChecked="{Binding AutoApproveTools}"
                                  Margin="0,0,24,8" />

                        <CheckBox x:Name="EnterToSendCheckBox"
                                  Content="按 Enter 直接发送消息（Shift+Enter 换行）"
                                  IsChecked="{Binding EnterToSend}"
                                  Margin="0,0,24,8" />
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,6" VerticalAlignment="Center">
                            <TextBlock Text="单轮最大自动步数:" VerticalAlignment="Center" />
                            <NumericUpDown Width="115" Minimum="1" Maximum="100" Value="{Binding MaxAutoSteps}" FormatString="0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,6" VerticalAlignment="Center">
                            <TextBlock Text="最小延迟(ms):" VerticalAlignment="Center" />
                            <NumericUpDown Width="125" Minimum="0" Maximum="60000" Increment="500" Value="{Binding DelayMinMs}" FormatString="0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,6" VerticalAlignment="Center">
                            <TextBlock Text="最大延迟(ms):" VerticalAlignment="Center" />
                            <NumericUpDown Width="125" Minimum="0" Maximum="120000" Increment="500" Value="{Binding DelayMaxMs}" FormatString="0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,20,6" VerticalAlignment="Center">
                            <TextBlock Text="单次字符上限:" VerticalAlignment="Center" />
                            <NumericUpDown Width="130" Minimum="800" Maximum="32000" Increment="500" Value="{Binding MaxPromptChars}" FormatString="0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="命令超时(秒):" VerticalAlignment="Center" />
                            <NumericUpDown Width="115" Minimum="5" Maximum="600" Increment="10" Value="{Binding CommandTimeoutSec}" FormatString="0" />
                        </StackPanel>
                    </WrapPanel>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="自定义浏览器路径 (可选)："
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CustomBrowserExecutablePath}"
                                 Watermark="默认自动探测系统中的 Microsoft Edge / Google Chrome" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 3. Main Conversation & Tool Execution Timeline -->
        <Border Grid.Row="3"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,10,0,10"
                Padding="12">
            <ScrollViewer x:Name="TimelineScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TimelineItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineItemViewModel">
                            <Border Background="{DynamicResource ToolCardBgBrush}"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    Margin="0,0,0,10">
                                <StackPanel Spacing="6">
                                    <!-- Header row -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Grid.Column="0"
                                                Background="{DynamicResource ElevatedBgBrush}"
                                                CornerRadius="5"
                                                Padding="7,2"
                                                Margin="0,0,8,0">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentHighlightBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusBadgeText}"
                                                   IsVisible="{Binding IsToolCall}"
                                                   Margin="10,0"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentHighlightBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding TimestampText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Message / Tool Payload Body -->
                                    <SelectableTextBlock Text="{Binding Content}"
                                                         TextWrapping="Wrap"
                                                         FontFamily="Cascadia Mono, Consolas, Menlo, monospace"
                                                         FontSize="13"
                                                         LineHeight="20" />

                                    <!-- Interactive Tool Approval Action Bar -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10"
                                                Margin="0,6,0,0"
                                                IsVisible="{Binding IsPendingApproval}">
                                        <Button Classes="success"
                                                Content="✓ 允许执行此命令"
                                                Command="{Binding ApproveCommand}" />
                                        <Button Classes="danger"
                                                Content="✕ 拒绝执行"
                                                Command="{Binding RejectCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 4. Bottom Task Composer: Plan/Execute Mode Toggle + Input + Send + Emergency Stop -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12,10">
            <StackPanel Spacing="8">
                <!-- Plan / Execute Mode Bar -->
                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <Border Grid.Column="0"
                            Background="{DynamicResource ElevatedBgBrush}"
                            CornerRadius="8"
                            Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton x:Name="PlanModeButton"
                                          Classes="segment"
                                          Padding="12,4"
                                          FontSize="12"
                                          Content="📋 规划模式"
                                          ToolTip.Tip="只允许查看目录、读取文件和截图分析，自动拦截写文件与终端命令，防止讨论方案时误改代码"
                                          IsChecked="{Binding IsPlanMode, Mode=OneWay}"
                                          Command="{Binding SwitchToPlanModeCommand}" />
                            <ToggleButton x:Name="ExecuteModeButton"
                                          Classes="segment"
                                          Padding="12,4"
                                          FontSize="12"
                                          Content="⚡ 执行模式"
                                          ToolTip.Tip="允许 Copilot 连续调用工具自动读写代码、执行 PowerShell、主动截图验收，直到完成任务"
                                          IsChecked="{Binding IsExecuteMode, Mode=OneWay}"
                                          Command="{Binding SwitchToExecuteModeCommand}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ModeHintText}"
                               Margin="12,0,0,0"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- Input & Actions Row -->
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox x:Name="PromptInputTextBox"
                             Grid.Column="0"
                             Text="{Binding PromptInputText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="52"
                             MaxHeight="130"
                             CornerRadius="8"
                             Watermark="直接输入任务发送（首次发送也会自动注入系统提示词），或点击右上角「✨ 新建对话」开启全新会话..."
                             KeyDown="OnPromptInputKeyDown" />

                    <Button x:Name="SendTaskButton"
                            Grid.Column="1"
                            Classes="primary"
                            Content="发送 ↵"
                            Margin="10,0,0,0"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Command="{Binding SendPromptCommand}" />

                    <Button x:Name="EmergencyStopButton"
                            Grid.Column="2"
                            Classes="danger"
                            Content="⏹ 急停"
                            Margin="8,0,0,0"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Command="{Binding EmergencyStopCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. Status Footer -->
        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="4,8,4,0">
            <TextBlock Grid.Column="0"
                       Text="{Binding AgentStatusText}"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding ActiveEditionLabel}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="· 累计调用工具:"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Text="{Binding TotalToolCallsCount}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentHighlightBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
